PORT=5000
MONGO_URI=mongodb://localhost:27017/farm_marketplace
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d
COOKIE_EXPIRE_DAYS=7
CLIENT_URL=http://localhost:5173
NODE_ENV=development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
